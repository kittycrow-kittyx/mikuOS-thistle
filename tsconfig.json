{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/teto/image-range.ts",
    "src/core/rv64-decode.ts",
    "src/teto/abi.ts",
    "src/teto/kernel.ts",
    "src/teto/vfs.ts",
    "src/teto/thx.ts",
    "src/teto/start.ts",
    "src/teto/types.ts",
    "src/teto/memory.ts",
    "src/teto/word.ts",
    "src/core/native-types.ts",
    "src/core/rv64-arithmetic.ts",
    "src/core/rv64-branch.ts",
    "src/core/rv64-fclass.ts",
    "src/core/rv64-immediate-op.ts",
    "src/core/rv64-numbers.ts",
    "src/core/rv64-register.ts",
    "src/core/rv64-word.ts",
    "src/vm/rv64-immediate.ts"
  ]
}
